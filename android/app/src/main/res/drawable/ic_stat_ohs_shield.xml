                          L15.48,8.64 L15.48,11.59
                          L13.47,11.59 L13.47,13.61
                          L10.52,13.61 L10.52,11.59
                          L8.51,11.59 L8.51,8.64
                          L10.52,8.64 Z" />
</vector>
